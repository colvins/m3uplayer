<Window x:Class="M3UPlayer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration" Title="轻播" Icon="Assets/LightM3U.ico" Width="1180" Height="760" MinWidth="800" MinHeight="520" Background="#F5F5F7" Foreground="#202024" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnKeyDown" AllowDrop="True" Drop="OnDrop">
  <Grid x:Name="LayoutRoot" Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel x:Name="Header" Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="Assets/LightM3U.png" Width="36" Height="36" Margin="0,0,10,0"/>
        <TextBlock Text="轻播" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="刷新列表" Click="RefreshPlaylist"/>
        <Button Content="导入文件" Click="ImportFile"/>
        <Button Content="添加订阅" Click="ImportUrl" Foreground="White" Background="#006EDC" Margin="0"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="Sidebar" Margin="0,0,16,0" Background="White" BorderBrush="#E5E5EA" BorderThickness="1" CornerRadius="14" Padding="12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="频道" FontSize="17" FontWeight="SemiBold" Margin="3,1,0,11"/>
          <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="管理" Margin="6,0,0,0" Padding="8,5" Click="ManageSources"/>
            <ComboBox x:Name="Sources" AutomationProperties.Name="播放来源" Padding="6,4" SelectionChanged="SourceChanged"/>
          </DockPanel>
          <Border Grid.Row="2" CornerRadius="8" Background="#F1F1F4" Margin="0,0,0,10">
            <Grid>
              <TextBlock Text="搜索频道" Foreground="#71717A" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <TextBox x:Name="Search" AutomationProperties.Name="搜索频道" TextChanged="FilterChanged"/>
            </Grid>
          </Border>
          <ComboBox x:Name="Groups" Grid.Row="3" Padding="8,5" SelectionChanged="GroupChanged" Margin="0,0,0,10"/>
          <ListBox x:Name="Channels" Grid.Row="4" Background="White" Foreground="#242428" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ChannelSelected" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Item" CornerRadius="8" Padding="9,7" Margin="0,1" Background="Transparent"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#F1F1F5"/></Trigger>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#E4F0FF"/><Setter Property="Foreground" Value="#0055B3"/></Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="#007AFF"/><Setter TargetName="Item" Property="BorderThickness" Value="1"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></Setter.Value></Setter>
            </Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Group}" Foreground="#666670" FontSize="11" Margin="0,2,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="VideoFrame" Background="Black" CornerRadius="12">
          <Grid>
            <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="选择一个频道" Foreground="#F5F5F7" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="也可以拖入 M3U 文件" Foreground="#AEAEB7" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
            <wfi:WindowsFormsHost x:Name="Video" Visibility="Hidden"/>
          </Grid>
        </Border>
        <Border x:Name="PlaybackBar" Grid.Row="1" Margin="0,12,0,0" Background="White" CornerRadius="12" Padding="14,11" BorderBrush="#E5E5EA" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="NowPlaying" Text="未选择频道" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,9"/>
            <DockPanel>
              <StackPanel Orientation="Horizontal"><Button x:Name="PauseButton" Content="暂停 / 继续" Click="TogglePause"/><Button Content="停止" Click="StopPlayback"/><Button Content="重试" Click="RetryPlayback"/><Button Content="全屏" ToolTip="双击画面或按 F11" Click="ToggleFullscreen"/></StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="音量" Foreground="#666670" Margin="8,0"/><Slider x:Name="Volume" Minimum="0" Maximum="100" Value="80" Width="100" ValueChanged="VolumeChanged"/></StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
    <DockPanel x:Name="StatusBar" Grid.Row="2" Margin="2,12,2,0">
      <TextBlock x:Name="Count" DockPanel.Dock="Right" Foreground="#666670" Margin="8,0,0,0"/>
      <TextBlock x:Name="Status" Text="准备就绪" Foreground="#666670" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
</Window>
