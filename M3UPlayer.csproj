<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>M3UPlayer</AssemblyName>
    <Version>0.4.6</Version>
    <ApplicationIcon>Assets/LightM3U.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/LightM3U.ico;Assets/LightM3U.png" />
    <Using Remove="System.Windows.Forms" /><Using Remove="System.Drawing" />
    <Compile Remove="tests/**/*.cs" />
    <None Update="engine/libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="libmpv-2.dll" />
    <None Update="engine/mdk/*.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
